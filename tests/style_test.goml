package tests;

use ecosystem::ansi;
use ecosystem::color;
use std::testing;

#[test]
fn every_attribute_transition_preserves_target_state() -> () {
    for bits in 0..512 {
        let target = ansi::Style {
            fg: ansi::Color::Rgb(21, 43, 65),
            bg: ansi::Color::Indexed(215),
            attributes: bits.to_u16(),
        };
        let previous = ansi::Style {
            fg: ansi::Color::Indexed(9),
            bg: ansi::Color::Rgb(9, 8, 7),
            attributes: (~bits.to_u16()) & ansi::ALL_ATTRIBUTES,
        };
        for profile in[
            ansi::Profile::Plain,
            ansi::Profile::Ansi16,
            ansi::Profile::Ansi256,
            ansi::Profile::TrueColor,
        ] {
            let output = previous.transition(ansi::Style::new(), profile)
                + target.transition(previous, profile)
                + "x";
            let parsed = testing::expect_ok(ansi::parse(output), "parse emitted transitions");
            testing::assert_eq(parsed.spans()[0].style, target.resolved(profile));
        }
    }
}

#[test]
fn rgb_palette_and_downsampling_are_deterministic() -> () {
    testing::assert(ansi::palette_rgb(16) == (0.to_u8(), 0.to_u8(), 0.to_u8()));
    testing::assert(ansi::palette_rgb(231) == (255.to_u8(), 255.to_u8(), 255.to_u8()));
    testing::assert(ansi::palette_rgb(232) == (8.to_u8(), 8.to_u8(), 8.to_u8()));
    testing::assert(ansi::palette_rgb(255) == (238.to_u8(), 238.to_u8(), 238.to_u8()));
    for index in 0..256 {
        let color = ansi::Color::Indexed(index.to_u8());
        testing::assert_eq(color.downsample(ansi::Profile::Ansi256), color);
    }
    let red = ansi::Color::from_srgb(color::Srgb::from_rgb8(255, 0, 0));
    testing::assert_eq(red.downsample(ansi::Profile::Ansi16), ansi::Color::Indexed(9));
    testing::assert_eq(red.downsample(ansi::Profile::Plain), ansi::Color::Default);
}

#[test]
fn patches_distinguish_inheritance_from_terminal_default() -> () {
    let base = ansi::Style::new().foreground(ansi::Color::Indexed(2)).with_attribute(
        ansi::BOLD | ansi::ITALIC,
        true,
    );
    let patched = base.patch(
        ansi::StylePatch {
            fg: Option::None,
            bg: Option::Some(ansi::Color::Indexed(4)),
            add: ansi::UNDERLINE,
            remove: ansi::BOLD,
        },
    );
    testing::assert_eq(patched.fg, base.fg);
    testing::assert_eq(patched.bg, ansi::Color::Indexed(4));
    testing::assert_eq(patched.attributes, ansi::ITALIC | ansi::UNDERLINE);
    testing::assert_eq(
        patched.patch(
            ansi::StylePatch { fg: Option::Some(ansi::Color::Default), ..ansi::StylePatch::new() },
        ).fg,
        ansi::Color::Default,
    );
}

#[test]
fn extended_sgr_accepts_semicolon_and_colon_encodings() -> () {
    for value in["38;2;10;20;30", "38:2:10:20:30", "38:2::10:20:30", "38:2:0:10:20:30"] {
        let style = testing::expect_ok(ansi::apply_sgr(ansi::Style::new(), value), value);
        testing::assert_eq(style.fg, ansi::Color::Rgb(10, 20, 30));
    }
    let style = testing::expect_ok(
        ansi::apply_sgr(ansi::Style::new(), "1;2;48:5:255;4:3;53"),
        "combined styles",
    );
    testing::assert_eq(style.attributes, ansi::BOLD | ansi::DIM | ansi::UNDERLINE | ansi::OVERLINE);
    testing::assert_eq(style.bg, ansi::Color::Indexed(255));
    for value in[
        "38;2;1;2",
        "38;5;256",
        "38:2:1:2:3:4",
        "38:2::256:0:0",
        "38;3;1",
        "-1",
        "99999999999999999",
    ] {
        testing::assert(ansi::apply_sgr(ansi::Style::new(), value).is_err());
    }
}

#[test]
fn ignored_underline_colors_do_not_change_other_sgr_attributes() -> () {
    let initial = ansi::Style::new().foreground(ansi::Color::Indexed(3)).with_attribute(
        ansi::ITALIC,
        true,
    );
    for value in["58;5;1", "58;2;31;44;0", "58:5:1", "58:2:31:44:0", "58:2::31:44:0", "59"] {
        testing::assert_eq(
            testing::expect_ok(ansi::apply_sgr(initial, value), "ignored underline color"),
            initial,
        );
        testing::assert_eq(
            testing::expect_ok(ansi::apply_sgr(initial, value + ";1"), "following bold"),
            initial.with_attribute(ansi::BOLD, true),
        );
    }
    let parsed = testing::expect_ok(
        ansi::parse("\u001b[3;33mA\u001b[58;2;31;44;0mB\u001b[58;5;1;1mC"),
        "underline color sequence",
    ).spans();
    testing::assert_eq(parsed.len(), 3);
    testing::assert_eq(parsed[0].style, initial);
    testing::assert_eq(parsed[1].style, initial);
    testing::assert_eq(parsed[2].style, initial.with_attribute(ansi::BOLD, true));
    for value in["58", "58;5", "58;5;256", "58;2;1;2", "58:2::256:0:0"] {
        testing::assert(ansi::apply_sgr(initial, value).is_err());
    }
}

#[test]
fn text_and_hyperlinks_cannot_inject_control_sequences() -> () {
    let styled = ansi::Style::new().foreground(ansi::Color::Indexed(1));
    testing::assert_eq(styled.paint("a\u001b[2Jb\u0007", ansi::Profile::Plain), "a�[2Jb�");
    testing::assert(ansi::Hyperlink::new("https://example.org/\u001b\\", "").is_err());
    testing::assert(ansi::Hyperlink::new("https://example.org", "bad;id").is_err());
    let link = testing::expect_ok(
        ansi::Hyperlink::new("https://example.org/a;b", "demo"),
        "valid link",
    );
    let text = ansi::StyledText::from_spans(
        Vec::from_array([ansi::Span::new("link", styled).with_link(link)]),
    );
    let rendered = text.render(ansi::Profile::TrueColor);
    let parsed = testing::expect_ok(ansi::parse(rendered), "hyperlink roundtrip");
    testing::assert(parsed.spans()[0].link == Option::Some(link));
    testing::assert_eq(text.render(ansi::Profile::Plain), "link");
    testing::assert(!text.render_with_links(ansi::Profile::TrueColor, false).contains("]8;"));
}

#[test]
fn safe_text_preserves_unicode_runs_and_replaces_terminal_controls() -> () {
    let clean = "é\u00a0\u00bfĀ界🙂e\u0301\u200d\u2028\u2029\ufeff�\t\n";
    for value in Vec::from_array(["", "A", clean, clean.repeat(128)]) {
        testing::assert_eq(ansi::safe_text(value), value);
        testing::assert_eq(ansi::StyledText::plain(value).render(ansi::Profile::Plain), value);
    }
    let controls = "\u0000\u0001\u0002\u0003\u0004\u0005\u0006\u0007\u0008\u000b\u000c\u000d\u000e\u000f\u0010\u0011\u0012\u0013\u0014\u0015\u0016\u0017\u0018\u0019\u001a\u001b\u001c\u001d\u001e\u001f\u007f\u0080\u0081\u0082\u0083\u0084\u0085\u0086\u0087\u0088\u0089\u008a\u008b\u008c\u008d\u008e\u008f\u0090\u0091\u0092\u0093\u0094\u0095\u0096\u0097\u0098\u0099\u009a\u009b\u009c\u009d\u009e\u009f";
    testing::assert_eq(ansi::safe_text(controls), "�".repeat(63));
    for control in controls.chars() {
        for prefix in Vec::from_array(["", "A", clean]) {
            for suffix in Vec::from_array(["", "Z", clean]) {
                let source = prefix + control.to_string() + suffix;
                let expected = prefix + "�" + suffix;
                testing::assert_eq(ansi::safe_text(source), expected);
                testing::assert_eq(ansi::Span::plain(source).text, expected);
                let text = ansi::StyledText::new();
                text.push(
                    ansi::Span { text: source, style: ansi::Style::new(), link: Option::None },
                );
                testing::assert_eq(text.render(ansi::Profile::TrueColor), expected);
            }
        }
    }
}

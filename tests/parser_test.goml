package tests;

use ecosystem::ansi;
use std::testing;

fn canonical(tokens: Vec[ansi::Token]) -> string {
    let parts: Vec[string] = Vec::new();
    let text: Vec[string] = Vec::new();
    for token in tokens {
        match token {
            Text(value) => text.push(value),
            _ => {
                if !text.is_empty() {
                    parts.push(text.join("").debug());
                    text.clear();
                }
                parts.push(token.debug());
            },
        }
    }
    if !text.is_empty() {
        parts.push(text.join("").debug());
    }
    parts.join("|")
}

#[test]
fn fragmented_sequences_and_utf8_match_complete_input() -> () {
    let value = "Aé中👩‍💻\u001b[1;38:2::7:8:9mB\u001b[0m\u001b]8;id=a;https://example.org\u001b\\link\u001b]8;;\u0007\n\u001b(0\u001bPopaque;data\u001b\\";
    let expected = canonical(testing::expect_ok(ansi::parse_tokens(value), "complete input"));
    let bytes = value.to_bytes();
    for split in 0..bytes.len() + 1 {
        let parser = ansi::Parser::new();
        let tokens = testing::expect_ok(
            parser.feed(bytes.as_slice().sub(0, split)),
            "first fragment",
        );
        for token in testing::expect_ok(
            parser.feed(bytes.as_slice().sub(split, bytes.len())),
            "second fragment",
        ) {
            tokens.push(token);
        }
        testing::expect_ok(parser.finish(), "complete parser");
        testing::assert_eq(canonical(tokens), expected);
    }
    let parser = ansi::Parser::new();
    let tokens = Vec::new();
    for value in bytes {
        for token in testing::expect_ok(
            parser.feed(Vec::from_array([value]).as_slice()),
            "single byte",
        ) {
            tokens.push(token);
        }
    }
    testing::expect_ok(parser.finish(), "one-byte finish");
    testing::assert_eq(canonical(tokens), expected);
}

#[test]
fn malformed_input_fails_until_explicit_reset() -> () {
    for bytes in[Vec::from_array([255.to_u8()]), "\u001b[1\n".to_bytes(), "\u001b\n".to_bytes()] {
        let parser = ansi::Parser::new();
        testing::assert(parser.feed(bytes.as_slice()).is_err());
        testing::assert(parser.feed("ok".to_bytes().as_slice()).is_err());
        parser.reset();
        testing::expect_ok(parser.feed("ok".to_bytes().as_slice()), "reset resumes parser");
        testing::expect_ok(parser.finish(), "finish after reset");
        testing::expect_ok(parser.finish(), "finish idempotent");
        testing::assert(parser.feed("x".to_bytes().as_slice()).is_err());
    }
    for value in["\u001b", "\u001b[31", "\u001b]missing terminator"] {
        testing::assert(ansi::parse_tokens(value).is_err());
    }
    let parser = ansi::Parser::new();
    testing::expect_ok(
        parser.feed(Vec::from_array([0xf0.to_u8(), 0x9f.to_u8()]).as_slice()),
        "truncated utf8 may continue",
    );
    testing::assert(parser.finish().is_err());
}

#[test]
fn parser_limits_bound_retained_input_and_parameter_work() -> () {
    let limits = ansi::Limits { max_sequence_bytes: 8, max_chunk_bytes: 16, max_parameters: 2 };
    for value in["\u001b]123456789", "\u001b[1;2;3m", "12345678901234567"] {
        let parser = testing::expect_ok(ansi::Parser::with_limits(limits), "bounded parser");
        testing::assert(parser.feed(value.to_bytes().as_slice()).is_err());
        testing::assert_eq(parser.pending_bytes(), 0);
    }
    testing::assert(
        ansi::Parser::with_limits(ansi::Limits { max_sequence_bytes: 0, ..limits }).is_err(),
    );
    testing::assert(
        ansi::Parser::with_limits(ansi::Limits { max_parameters: 0, ..limits }).is_err(),
    );
    let parser = testing::expect_ok(ansi::Parser::with_limits(limits), "exact boundary");
    testing::expect_ok(
        parser.feed("\u001b]abcd\u001b\\".to_bytes().as_slice()),
        "eight-byte sequence",
    );
    testing::expect_ok(parser.finish(), "bounded finish");
}

#[test]
fn resumed_csi_and_escape_scans_preserve_fields_and_alias_reset() -> () {
    let valid = "pre\u001b[1;2::3$ qmiddle\u001b((((B\u001b[0m\u001b[1m";
    let expected = canonical(testing::expect_ok(ansi::parse_tokens(valid), "whole sequences"));
    let bytes = valid.to_bytes();
    for size in Vec::from_array([1, 2, 3, 5, 17]) {
        let parser = ansi::Parser::new();
        let tokens = Vec::new();
        let mut at = 0;
        while at < bytes.len() {
            let end = if at + size < bytes.len() {
                at + size
            } else {
                bytes.len()
            };
            for token in testing::expect_ok(parser.feed(bytes.slice(at, end)), "fragment") {
                tokens.push(token);
            }
            testing::assert_ok(parser.feed("".to_bytes().as_slice()));
            at = end;
        }
        testing::assert_ok(parser.finish());
        testing::assert_eq(canonical(tokens), expected);
    }
    let parser = ansi::Parser::new();
    let alias = parser;
    testing::assert_ok(parser.feed("text\u001b[1;2$".to_bytes().as_slice()));
    testing::assert_eq(parser.pending_bytes(), 6);
    alias.reset();
    testing::assert_eq(parser.pending_bytes(), 0);
    testing::assert_ok(parser.feed("\u001b((".to_bytes().as_slice()));
    testing::assert_eq(
        canonical(testing::expect_ok(alias.feed("B".to_bytes().as_slice()), "shared progress")),
        canonical(Vec::from_array([ansi::Token::Escape("((B")])),
    );
    testing::assert_ok(alias.finish());
}

#[test]
fn resumed_csi_and_escape_scans_preserve_limits_and_error_offsets() -> () {
    let limits = ansi::Limits {
        max_sequence_bytes: 8,
        max_parameters: 2,
        ..ansi::Limits::standard(),
    };
    for value in Vec::from_array(
        [
            "pre\u001b[1;2;3m",
            "pre\u001b[1:2:3m",
            "pre\u001b[1 $2m",
            "pre\u001b((((\n",
            "pre\u001b[123456m",
            "pre\u001b[1     q",
            "pre\u001b(((((((B",
        ],
    ) {
        let whole = testing::expect_ok(ansi::Parser::with_limits(limits), "whole parser");
        let expected = testing::expect_err(whole.feed(value.to_bytes().as_slice()), "whole error");
        let bytes = value.to_bytes();
        for split in 0..bytes.len() + 1 {
            let parser = testing::expect_ok(ansi::Parser::with_limits(limits), "split parser");
            let actual = match parser.feed(bytes.slice(0, split)) {
                Err(error) => error,
                Ok(_) => testing::expect_err(
                    parser.feed(bytes.slice(split, bytes.len())),
                    "split error",
                ),
            };
            testing::assert_eq(actual, expected);
            testing::assert_eq(parser.pending_bytes(), 0);
            testing::assert_err(parser.finish());
        }
    }
    for value in Vec::from_array(["\u001b[12345m", "\u001b[1    q", "\u001b((((((B"]) {
        let parser = testing::expect_ok(ansi::Parser::with_limits(limits), "exact limit parser");
        let tokens = Vec::new();
        for byte in value.to_bytes() {
            for token in testing::expect_ok(
                parser.feed(Vec::from_array([byte]).as_slice()),
                "exact limit byte",
            ) {
                tokens.push(token);
            }
        }
        testing::assert_eq(
            canonical(tokens),
            canonical(testing::expect_ok(ansi::parse_tokens(value), "complete exact sequence")),
        );
        testing::assert_ok(parser.finish());
    }
}

#[test]
fn stripping_drops_commands_but_keeps_text_line_breaks_and_tabs() -> () {
    let value = "\u001b[2J\u001b[Hhello\u001b[31m red\u001b[0m\u0007\n\tworld\u001b]0;title\u0007\u001bPprivate\u001b\\";
    testing::assert_eq(
        testing::expect_ok(ansi::strip(value), "strip commands"),
        "hello red\n\tworld",
    );
    testing::assert_eq(
        testing::expect_ok(ansi::parse(value), "parse styled text").plain_text(),
        "hello red\n\tworld",
    );
}
